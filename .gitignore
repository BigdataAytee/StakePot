pnpm-debug.log*

# editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# sentry
.sentryclirc

# service worker, generated by @serwist/next at build time
apps/web/public/sw.js
apps/web/public/sw.js.map

# playwright
apps/web/test-results/
apps/web/playwright-report/

