{
  "name": "@stakeam/engine",
  "version": "0.1.0",
  "private": true,
  "description": "StakeAm hybrid pricing engine — architecture §2.3 v1.1. Pure TypeScript, decimal.js only.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:props": "vitest run src/__tests__/engine.props.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "migrate": "node -e \"console.log('no database in packages/engine — run pnpm --filter @stakeam/api migrate')\""
  },
  "dependencies": {
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "fast-check": "^4.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
