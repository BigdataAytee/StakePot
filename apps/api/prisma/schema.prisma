// StakeAm data model — architecture §3.
//
// Conventions:
//   * tables are snake_case via @@map; model and field names stay idiomatic Prisma
//   * ids are cuid unless the row is naturally keyed or is high-volume time series
//   * every money or share quantity is Decimal(38,18) — never Float, anywhere
//   * `ledger` and `admin_audit` are append-only; the REVOKE that enforces it
//     lives in prisma/migrations/20240101000001_ledger_append_only

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

enum Currency {
  /// SPcoin — the points-mode currency (§2.2, §7.4). Flips to NGN at licensing.
  SPC
  NGN
}

/// §6.11's role → screen matrix. §3 enumerated only the first four; the admin
/// spec names five staff roles, and a permission matrix that cannot express
/// "support staff can read tickets but not the ledger" (§2.11) is not one.
enum UserRole {
  user
  creator
  /// Support desk + read-only user context. No money, no markets.
  support
  /// Resolution centre and disputes. No balances.
  resolver
  /// Users, abuse queue, creators desk.
  trust_safety
  /// Money room, and one of the two eyes on a money approval.
  finance
  /// Everything — but still no solo money moves, and every click audited.
  admin
}

enum LedgerType {
  signup_bonus
  trade_buy
  trade_sell
  stake
  seed
  payout
  refund
  fee_platform
  fee_creator
  bond_post
  bond_refund
  bond_forfeit
  prize
  /// A manual correction, only ever reachable through the four-eyes approvals
  /// workflow (§2.10). Typed distinctly so "money a human moved by hand" is one
  /// query, not an inference.
  adjustment
}

enum FundClass {
  user_escrow
  user_available
  platform_fees
  prize_pool
}

enum MarketShelf {
  official
  community
}

enum MarketState {
  draft
  seeding
  funding
  active
  frozen
  pending_resolution
  dispute_window
  resolved
  voided
}

enum TradeSide {
  buy
  sell
  /// A Path B symmetric seed leg (§2.4). Recorded per outcome so the seed shows
  /// in market history, and excluded everywhere a *stake* is counted — a seed is
  /// liquidity, not an opinion, and it can never satisfy an activation floor.
  seed
}

enum BondState {
  held
  refunded
  forfeited
}

enum DraftSource {
  ai
  community
}

enum DraftState {
  suggested
  approved
  rejected
}

enum ApprovalState {
  pending
  approved
  rejected
}

/// Where a support ticket is (§2.12, §6.7). `waiting_on_user` stops the SLA
/// clock — a ticket the team has answered is not a ticket the team is late on.
enum TicketState {
  open
  waiting_on_user
  escalated
  resolved
  closed
}

/// §2.12's categories. RG requests are their own category because they are the
/// one kind of ticket that is never a support question — it is a person asking
/// to be stopped, and it has the tightest SLA.
enum TicketCategory {
  payout_query
  dispute
  account
  rg_request
  other
}

/// How a notification reached someone (§2.12).
enum NotificationChannel {
  in_app
  push
  email
  sms
}

/// A status-page incident's severity (§2.12). Three, matching §6.10's alarm
/// discipline — anything else is decoration.
enum IncidentSeverity {
  informational
  degraded
  outage
}

enum IncidentState {
  investigating
  identified
  monitoring
  resolved
}

/// A dispute's life (§2.6, Rulebook Part 1 §5). `withdrawn` is the filer
/// changing their mind; only a resolver can uphold or reject.
enum DisputeState {
  open
  upheld
  rejected
  withdrawn
}

enum TemplateCategory {
  bbnaija
  football
  election
  economic
  awards
  transfer
  other
}

enum OpportunitySource {
  calendar
  search_gap
  seasonal
}

enum CommentState {
  live
  flagged
  removed
}

/// §6.4b: a key is `active`, has a `pending` successor awaiting its effective
/// date, or is `superseded`.
enum ConfigState {
  active
  pending
  superseded
}

/// How a community market reaches `active` (§2.4, Rulebook Part 3 §2).
enum ActivationPath {
  /// Path A: a funding window that must fill on its own.
  organic
  /// Path B: a symmetric seed from the creator or a syndicate.
  seeded
}

/// Seeding-round lifecycle (Rulebook Part 3 §3).
enum SyndicateState {
  /// Taking contributions.
  open
  /// Reached the seed minimum and activated the market.
  filled
  /// Ended short of the minimum; every contribution was returned.
  refunded
}

enum AnnotationType {
  open
  activation
  big_trade
  news
  freeze
  resolution
}

// ---------------------------------------------------------------- identity & money

model User {
  id              String   @id @default(cuid())
  email           String?  @unique
  phone           String?  @unique
  contactVerified Boolean  @default(false)
  /// 0 = unverified, 1 = contact verified, 2 = KYC passed
  tier            Int      @default(0)
  kycRef          String?
  pwHash          String
  /// TOTP shared secret (§2.11). Present once enrolment starts; `totpConfirmedAt`
  /// is what makes it live, so a half-finished enrolment cannot lock anyone out.
  totpSecret      String?
  totpConfirmedAt DateTime?
  role            UserRole @default(user)
  /// Not enumerated in §3; kept free-form until the states are pinned down.
  status          String   @default("active")
  createdAt       DateTime @default(now())

  wallets            Wallet[]
  ledgerEntries      LedgerEntry[]
  trades             Trade[]
  positions          Position[]
  markets            Market[]            @relation("MarketCreator")
  syndicates         Syndicate[]
  syndicateMembers   SyndicateMember[]
  bonds              Bond[]
  disputes           Dispute[]
  supportTickets     SupportTicket[]
  rgSettings         RgSettings?
  notifications      Notification[]
  notificationPrefs  NotificationPreference[]
  pushSubscriptions  PushSubscription[]
  supportMessages    SupportMessage[]
  events             Event[]
  creatorProfile     CreatorProfile?
  following          Follower[]          @relation("Follows")
  followers          Follower[]          @relation("FollowedBy")
  autopsies          MarketAutopsy[]
  comments           Comment[]
  reputation         Reputation[]
  squadsOwned        Squad[]
  squadMemberships   SquadMember[]
  challenges         Challenge[]
  topCalls           TopCall[]
  leaderboardSnapshots LeaderboardSnapshot[]
  opportunities      Opportunity[]
  proposedResolutions Resolution[]       @relation("ResolutionProposer")
  finalizedResolutions Resolution[]      @relation("ResolutionFinalizer")

  @@map("users")
}

model Wallet {
  userId    String
  currency  Currency
  available Decimal  @default(0) @db.Decimal(38, 18)
  escrowed  Decimal  @default(0) @db.Decimal(38, 18)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, currency])
  @@map("wallets")
}

/// APPEND-ONLY. UPDATE and DELETE are revoked from the application role in
/// migration 20240101000001_ledger_append_only — corrections are new rows.
model LedgerEntry {
  id        String     @id @default(cuid())
  userId    String
  marketId  String?
  type      LedgerType
  fundClass FundClass
  amount    Decimal    @db.Decimal(38, 18)
  currency  Currency
  ref       String?
  createdAt DateTime   @default(now())

  user   User    @relation(fields: [userId], references: [id])
  market Market? @relation(fields: [marketId], references: [id])

  @@index([userId, createdAt])
  @@index([marketId, createdAt])
  @@index([type, createdAt])
  @@map("ledger")
}

// ---------------------------------------------------------------- markets & trading

model Market {
  id                 String      @id @default(cuid())
  shelf              MarketShelf
  question           String
  sourceName         String
  sourceUrl          String
  criteriaJson       Json
  edgeCasesJson      Json
  eventDate          DateTime
  voidDate           DateTime
  state              MarketState @default(draft)
  activationPath     ActivationPath @default(organic)
  /// When the funding window closes. Path A activates or voids at this moment;
  /// Path B re-checks the participation floor. Stored rather than derived from
  /// `createdAt`, because the queue is not a source of truth and the schedule
  /// has to be rebuildable from Postgres alone.
  fundingClosesAt    DateTime?
  /// When the 48h dispute window shuts (§2.6). Set when a resolution is
  /// proposed; the market cannot be finalised before it, and the job that
  /// closes it is rebuilt from this column rather than from a queue.
  disputeClosesAt    DateTime?
  creatorId          String?
  /// Liquidity constant L from §2.3. Immutable once the market is created.
  liquidityParam     Decimal     @db.Decimal(38, 18)
  potTotal           Decimal     @default(0) @db.Decimal(38, 18)
  feeBps             Int
  resolvedOutcomeId  String?
  resolutionEvidence String?
  createdAt          DateTime    @default(now())

  creator         User?             @relation("MarketCreator", fields: [creatorId], references: [id])
  resolvedOutcome Outcome?          @relation("ResolvedOutcome", fields: [resolvedOutcomeId], references: [id])
  outcomes        Outcome[]         @relation("MarketOutcomes")
  trades          Trade[]
  positions       Position[]
  ledgerEntries   LedgerEntry[]
  syndicates      Syndicate[]
  bonds           Bond[]
  resolutions     Resolution[]
  disputes        Dispute[]
  outcomeLog      MarketOutcomeLog?
  supportTickets  SupportTicket[]
  autopsy         MarketAutopsy?
  comments        Comment[]
  challenges      Challenge[]
  topCalls        TopCall[]
  priceHistory    PriceHistory[]
  annotations     MarketAnnotation[]

  @@index([shelf, state])
  @@index([state, eventDate])
  @@map("markets")
}

model Outcome {
  id                String  @id @default(cuid())
  marketId          String
  label             String
  /// Position in the engine's share vector. Explicit rather than inferred from
  /// insertion order: this number indexes into q[], and getting it wrong would
  /// silently price one outcome as another.
  ordinal           Int
  sharesOutstanding Decimal @default(0) @db.Decimal(38, 18)
  priceCurrent      Decimal @default(0) @db.Decimal(38, 18)
  /// Money staked on this outcome, net of early exits. Σ across a market's
  /// outcomes equals `markets.potTotal`.
  ///
  /// Not in §3, and needed since v2 §2.3 moved the fee basis to the losing pool
  /// — the cost curve keeps one pot, so what was staked per outcome has to be
  /// carried alongside it. A cache of the trades table, like `potTotal` and
  /// `sharesOutstanding` already are.
  stakedTotal       Decimal @default(0) @db.Decimal(38, 18)
  /// The catch-all bucket on a multi-outcome ticket.
  isOther           Boolean @default(false)

  market       Market         @relation("MarketOutcomes", fields: [marketId], references: [id], onDelete: Cascade)
  wonBy        Market[]       @relation("ResolvedOutcome")
  trades       Trade[]
  positions    Position[]
  resolutionsProposed Resolution[] @relation("ProposedOutcome")
  resolutionsFinal    Resolution[] @relation("FinalOutcome")
  priceHistory PriceHistory[]

  @@unique([marketId, ordinal])
  @@index([marketId])
  @@map("outcomes")
}

model Trade {
  id         String    @id @default(cuid())
  marketId   String
  outcomeId  String
  userId     String
  side       TradeSide
  shares     Decimal   @db.Decimal(38, 18)
  cost       Decimal   @db.Decimal(38, 18)
  fee        Decimal   @default(0) @db.Decimal(38, 18)
  priceAfter Decimal   @db.Decimal(38, 18)
  /// Idempotency key — a retried trade request must never double-fill.
  requestId  String    @unique
  createdAt  DateTime  @default(now())

  market  Market  @relation(fields: [marketId], references: [id])
  outcome Outcome @relation(fields: [outcomeId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([marketId, createdAt])
  @@index([userId, createdAt])
  @@map("trades")
}

model Position {
  userId      String
  marketId    String
  outcomeId   String
  shares      Decimal @default(0) @db.Decimal(38, 18)
  avgPrice    Decimal @default(0) @db.Decimal(38, 18)
  realizedPnl Decimal @default(0) @db.Decimal(38, 18)

  user    User    @relation(fields: [userId], references: [id])
  market  Market  @relation(fields: [marketId], references: [id])
  outcome Outcome @relation(fields: [outcomeId], references: [id])

  @@id([userId, marketId, outcomeId])
  @@index([marketId])
  @@map("positions")
}

// ---------------------------------------------------------------- syndicates & bonds

model Syndicate {
  id          String   @id @default(cuid())
  marketId    String   @unique
  creatorId   String
  roundEndsAt DateTime
  /// Total the round must reach to activate: perOutcomeMin × outcomes.
  minTotal    Decimal  @db.Decimal(38, 18)
  /// The Symmetric Seed minimum per pool ([20,000] pts).
  perOutcomeMin   Decimal @db.Decimal(38, 18)
  /// Smallest contribution a sponsor may make ([2,000] pts).
  minContribution Decimal @db.Decimal(38, 18)
  /// Maximum sponsors on the round ([20]).
  maxSponsors     Int
  /// Organiser's cut of the syndicate fee, in basis points. 0 = pure pro-rata.
  /// Locked when the round opens: §3 says the split "is displayed on the market
  /// page before any sponsor joins and is locked once the Seeding Round opens".
  organiserBps    Int     @default(0)
  state           SyndicateState @default(open)
  openedAt        DateTime @default(now())
  filledAt        DateTime?

  market  Market            @relation(fields: [marketId], references: [id])
  creator User              @relation(fields: [creatorId], references: [id])
  members SyndicateMember[]

  @@index([state, roundEndsAt])
  @@map("syndicates")
}

model SyndicateMember {
  id           String  @id @default(cuid())
  syndicateId  String
  userId       String
  contribution Decimal @db.Decimal(38, 18)
  /// Share of the syndicate fee, as a fraction in [0,1]. Written when the round
  /// fills, not when a sponsor joins — pro-rata is only knowable once the round
  /// is closed. The shares sum to exactly 1; the organiser carries the remainder.
  feeSharePct  Decimal @default(0) @db.Decimal(38, 18)
  createdAt    DateTime @default(now())

  syndicate Syndicate @relation(fields: [syndicateId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@unique([syndicateId, userId])
  @@map("syndicate_members")
}

model Bond {
  id        String    @id @default(cuid())
  /// One bond per market — the creator's, posted at creation (Part 3 §1).
  marketId  String    @unique
  creatorId String
  amount    Decimal   @db.Decimal(38, 18)
  state     BondState @default(held)
  /// Why it was forfeited, for the audit trail (Part 3 §5).
  reason     String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  market  Market @relation(fields: [marketId], references: [id])
  creator User   @relation(fields: [creatorId], references: [id])

  @@index([creatorId, state])
  @@map("bonds")
}

// ---------------------------------------------------------------- resolution & disputes

model Resolution {
  id                 String    @id @default(cuid())
  marketId           String
  proposedBy         String
  proposedOutcomeId  String
  evidenceUrl        String
  proposedAt         DateTime  @default(now())
  finalizedBy        String?
  finalizedAt        DateTime?
  finalOutcomeId     String?

  market          Market   @relation(fields: [marketId], references: [id])
  proposer        User     @relation("ResolutionProposer", fields: [proposedBy], references: [id])
  finalizer       User?    @relation("ResolutionFinalizer", fields: [finalizedBy], references: [id])
  proposedOutcome Outcome  @relation("ProposedOutcome", fields: [proposedOutcomeId], references: [id])
  finalOutcome    Outcome? @relation("FinalOutcome", fields: [finalOutcomeId], references: [id])

  @@index([marketId])
  @@map("resolutions")
}

model Dispute {
  id          String       @id @default(cuid())
  marketId    String
  userId      String
  evidenceUrl String
  text        String
  state       DisputeState @default(open)
  decidedBy   String?
  decision    String?
  createdAt   DateTime     @default(now())
  decidedAt   DateTime?

  market Market @relation(fields: [marketId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([marketId, state])
  @@map("disputes")
}

// ---------------------------------------------------------------- drafting & review

model MarketDraft {
  id                String      @id @default(cuid())
  source            DraftSource
  templateJson      Json
  balanceEstimate   Decimal     @db.Decimal(38, 18)
  engagementScore   Decimal     @db.Decimal(38, 18)
  blocklistFlags    Json
  state             DraftState  @default(suggested)
  reviewedBy        String?
  createdAt         DateTime    @default(now())

  @@index([state, createdAt])
  @@map("market_drafts")
}

model MarketOutcomeLog {
  marketId     String  @id
  initialSplit Decimal @db.Decimal(38, 18)
  finalSplit   Decimal @db.Decimal(38, 18)
  volume       Decimal @db.Decimal(38, 18)
  disputeCount Int     @default(0)

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@map("market_outcomes_log")
}

model Approval {
  id          String        @id @default(cuid())
  actionType  String
  payloadJson Json
  requestedBy String
  approver1   String?
  approver2   String?
  state       ApprovalState @default(pending)
  createdAt   DateTime      @default(now())
  /// Mandatory: §6.4b requires a written reason on every proposal, and the
  /// approver is being asked to agree with a stated case, not a bare diff.
  reason      String        @default("")
  decidedAt   DateTime?
  /// Why it was refused, shown back to the proposer.
  rejection   String?
  /// When the action actually ran. An approved-but-unexecuted row is an
  /// incident, so the two timestamps are kept apart.
  executedAt  DateTime?

  @@index([state, createdAt])
  @@index([actionType, state])
  @@map("approvals")
}

/// APPEND-ONLY, same REVOKE as `ledger`.
model AdminAudit {
  id         String   @id @default(cuid())
  staffId    String
  action     String
  targetRef  String
  beforeJson Json?
  afterJson  Json?
  ip         String
  ts         DateTime @default(now())

  @@index([staffId, ts])
  @@map("admin_audit")
}

model ReconciliationRun {
  id          String   @id @default(cuid())
  runDate     DateTime
  ledgerTotal Decimal  @db.Decimal(38, 18)
  walletTotal Decimal  @db.Decimal(38, 18)
  bankTotal   Decimal? @db.Decimal(38, 18)
  /// Not enumerated in §3.
  status      String
  diff        Decimal  @db.Decimal(38, 18)
  clearedBy   String?

  @@index([runDate])
  @@map("reconciliation_runs")
}

// ---------------------------------------------------------------- support, RG, comms

model SupportTicket {
  id          String         @id @default(cuid())
  userId      String
  marketId    String?
  category    TicketCategory
  subject     String
  state       TicketState    @default(open)
  /// When the team is late. Set from the category's SLA at open, and paused by
  /// moving the ticket to `waiting_on_user`.
  slaDue      DateTime
  assignedTo  String?
  escalatedAt DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user     User             @relation(fields: [userId], references: [id])
  market   Market?          @relation(fields: [marketId], references: [id])
  messages SupportMessage[]

  @@index([state, slaDue])
  @@index([userId, createdAt])
  @@map("support_tickets")
}

/// One turn in a ticket's conversation. `staffOnly` is an internal note: the
/// support desk needs somewhere to think that is not shown to the user.
model SupportMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  staffOnly Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model RgSettings {
  userId       String    @id
  /// Daily limits. Null means "no limit of your own" — the platform cap still
  /// applies, and in points mode it sits high but is fully enforced (§2.12).
  depositLimit Decimal?  @db.Decimal(38, 18)
  stakeLimit   Decimal?  @db.Decimal(38, 18)
  lossLimit    Decimal?  @db.Decimal(38, 18)
  cooloffUntil DateTime?
  selfExcluded Boolean   @default(false)
  /// When the exclusion was taken. Permanent per §2.12, and this is the record
  /// of when it started — a self-exclusion with no date is not evidence.
  selfExcludedAt DateTime?
  /// §2.12's session reality check, at [60] minutes of continuous use.
  sessionStartedAt   DateTime?
  lastRealityCheckAt DateTime?
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("rg_settings")
}

model Notification {
  id          String              @id @default(cuid())
  userId      String
  type        String
  payloadJson Json
  channel     NotificationChannel
  /// Null while the send is pending or if the channel refused it; the row is
  /// written either way, so "we tried to tell them" is a fact on the record.
  sentAt      DateTime?           @default(now())
  failure     String?
  readAt      DateTime?
  createdAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

/// Per-user, per-channel opt-outs (§2.12). A missing row means the channel's
/// default applies, so a new channel does not silently start messaging people.
model NotificationPreference {
  userId  String
  channel NotificationChannel
  enabled Boolean             @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, channel])
  @@map("notification_preferences")
}

/// A browser's push endpoint (web-push). Keyed by endpoint because that is what
/// the browser rotates, and a stale one must be replaced rather than duplicated.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// The public status page (§2.12): "incidents posted with timestamps —
/// transparency as a feature."
model StatusIncident {
  id         String           @id @default(cuid())
  title      String
  severity   IncidentSeverity
  state      IncidentState    @default(investigating)
  startedAt  DateTime         @default(now())
  resolvedAt DateTime?
  postedBy   String
  updates    IncidentUpdate[]

  @@index([state, startedAt])
  @@map("status_incidents")
}

model IncidentUpdate {
  id         String        @id @default(cuid())
  incidentId String
  state      IncidentState
  body       String
  postedBy   String
  createdAt  DateTime      @default(now())

  incident StatusIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
  @@map("incident_updates")
}

model Event {
  id             String   @id @default(cuid())
  userId         String?
  name           String
  propertiesJson Json
  ts             DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([name, ts])
  @@index([userId, ts])
  @@map("events")
}

// ---------------------------------------------------------------- creators & community

model CreatorProfile {
  userId            String  @id
  /// 1 | 2 | 3
  level             Int     @default(1)
  cleanResolutions  Int     @default(0)
  totalVolumeHosted Decimal @default(0) @db.Decimal(38, 18)
  accuracyPct       Decimal @default(0) @db.Decimal(38, 18)
  badgeFlags        Json
  followerCount     Int     @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("creator_profiles")
}

model Follower {
  followerId String
  creatorId  String
  notify     Boolean  @default(true)
  createdAt  DateTime @default(now())

  follower User @relation("Follows", fields: [followerId], references: [id], onDelete: Cascade)
  creator  User @relation("FollowedBy", fields: [creatorId], references: [id], onDelete: Cascade)

  @@id([followerId, creatorId])
  @@index([creatorId])
  @@map("followers")
}

model TicketTemplate {
  id                String           @id @default(cuid())
  category          TemplateCategory
  templateJson      Json
  localisableFields Json
  seasonWindow      String?
  active            Boolean          @default(true)

  opportunities Opportunity[]

  @@index([category, active])
  @@map("ticket_templates")
}

model Opportunity {
  id           String            @id @default(cuid())
  source       OpportunitySource
  title        String
  templateId   String?
  demandScore  Decimal           @db.Decimal(38, 18)
  claimedBy    String?
  expiresAt    DateTime

  template TicketTemplate? @relation(fields: [templateId], references: [id])
  claimer  User?           @relation(fields: [claimedBy], references: [id])

  @@index([expiresAt])
  @@map("opportunities")
}

model MarketAutopsy {
  marketId       String   @id
  creatorId      String
  outcomeSummary String
  tipsJson       Json
  createdAt      DateTime @default(now())

  market  Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  creator User   @relation(fields: [creatorId], references: [id])

  @@map("market_autopsies")
}

model Comment {
  id       String       @id @default(cuid())
  marketId String
  userId   String
  text     String
  /// Snapshot of the commenter's position at the time, e.g. "YES@62" or "none".
  positionSnapshot String
  parentId String?
  state    CommentState @default(live)
  createdAt DateTime    @default(now())

  market  Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id])
  parent  Comment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentThread")

  @@index([marketId, createdAt])
  @@map("comments")
}

model Reputation {
  userId      String
  category    String
  accuracyPct Decimal @db.Decimal(38, 18)
  calibration Decimal @db.Decimal(38, 18)
  title       String?
  season      String
  sampleSize  Int     @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category, season])
  @@map("reputation")
}

model Squad {
  id             String   @id @default(cuid())
  name           String
  ownerId        String
  memberCount    Int      @default(0)
  /// Not enumerated in §3.
  screeningState String   @default("pending")
  createdAt      DateTime @default(now())

  owner       User             @relation(fields: [ownerId], references: [id])
  members     SquadMember[]
  challengesA SquadChallenge[] @relation("SquadA")
  challengesB SquadChallenge[] @relation("SquadB")

  @@map("squads")
}

model SquadMember {
  squadId  String
  userId   String
  joinedAt DateTime @default(now())

  squad Squad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([squadId, userId])
  @@map("squad_members")
}

model SquadChallenge {
  id             String  @id @default(cuid())
  squadA         String
  squadB         String
  marketSetJson  Json
  period         String
  scoreA         Decimal @default(0) @db.Decimal(38, 18)
  scoreB         Decimal @default(0) @db.Decimal(38, 18)
  /// Not enumerated in §3.
  state          String  @default("open")

  a Squad @relation("SquadA", fields: [squadA], references: [id])
  b Squad @relation("SquadB", fields: [squadB], references: [id])

  @@map("squad_challenges")
}

model Challenge {
  id               String   @id @default(cuid())
  marketId         String
  challengerId     String
  positionSnapshot String
  linkToken        String   @unique
  acceptedBy       String?
  createdAt        DateTime @default(now())

  market     Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  challenger User   @relation(fields: [challengerId], references: [id])

  @@map("challenges")
}

model TopCall {
  id              String  @id @default(cuid())
  week            String
  userId          String
  marketId        String
  entryPrice      Decimal @db.Decimal(38, 18)
  resolvedOutcome String
  featured        Boolean @default(false)

  user   User   @relation(fields: [userId], references: [id])
  market Market @relation(fields: [marketId], references: [id])

  @@index([week, featured])
  @@map("top_calls")
}

// ---------------------------------------------------------------- chart data

/// High-volume time series: a bigint identity key rather than a cuid, since
/// nothing links to these rows by id.
model PriceHistory {
  id        BigInt   @id @default(autoincrement())
  marketId  String
  outcomeId String
  price     Decimal  @db.Decimal(38, 18)
  pot       Decimal  @db.Decimal(38, 18)
  ts        DateTime @default(now())

  market  Market  @relation(fields: [marketId], references: [id], onDelete: Cascade)
  outcome Outcome @relation(fields: [outcomeId], references: [id], onDelete: Cascade)

  @@index([marketId, outcomeId, ts])
  @@map("price_history")
}

/// The §7.2 chart annotations.
model MarketAnnotation {
  id       String         @id @default(cuid())
  marketId String
  type     AnnotationType
  label    String
  ts       DateTime       @default(now())

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId, ts])
  @@map("market_annotations")
}

/// §3 leaderboard snapshots — served from replicas, never the trade path (§11).
model LeaderboardSnapshot {
  period   String
  userId   String
  profit   Decimal @db.Decimal(38, 18)
  accuracy Decimal @db.Decimal(38, 18)
  rank     Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([period, userId])
  @@index([period, rank])
  @@map("leaderboard_snapshots")
}

// ---------------------------------------------------------------- platform config (§6.4b)

/// Every tunable value in the architecture lives here, never in code: fees,
/// exit-fee rate, activation thresholds, window lengths, bond size, Tier limits,
/// RG defaults, dispute-window length, the kyc_required_at switch.
///
/// Changes are proposals through the four-eyes workflow (§2.10), take effect
/// after a visible delay, and never apply retroactively — a market already open
/// resolves under the values in force when it opened.
model PlatformConfig {
  key         String
  valueJson   Json
  effectiveAt DateTime
  version     Int
  state       ConfigState @default(pending)

  @@id([key, version])
  @@index([key, state])
  @@index([state, effectiveAt])
  @@map("platform_config")
}

/// APPEND-ONLY, same REVOKE and triggers as `ledger`.
///
/// §6.4b: "one-click rollback creates a new proposal, never an edit of
/// history". A config history that can be rewritten is not an audit trail, and
/// these rows are the record of who changed platform economics and why.
model ConfigVersion {
  id          String    @id @default(cuid())
  key         String
  oldValue    Json?
  newValue    Json
  /// Mandatory free text — §6.4b requires a stated reason on every change.
  reason      String
  proposedBy  String
  approvedBy  String
  proposedAt  DateTime  @default(now())
  activatedAt DateTime?

  @@index([key, proposedAt])
  @@map("config_versions")
}
