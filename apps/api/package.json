{
  "name": "@stakeam/api",
  "version": "0.1.0",
  "private": true,
  "description": "StakeAm API, trade workers and jobs.",
  "main": "dist/main.js",
  "scripts": {
    "predev": "pnpm run prisma:generate && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --enable-source-maps dist/main.js",
    "prebuild": "pnpm run prisma:generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run --passWithNoTests",
    "test:props": "vitest run src/ledger/posting.test.ts",
    "typecheck": "pnpm run prisma:generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.1.6",
    "@prisma/client": "^6.19.0",
    "@sentry/node": "^10.24.0",
    "@stakeam/engine": "workspace:*",
    "argon2": "^0.44.0",
    "bullmq": "^6.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.2",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "fast-check": "^4.9.0",
    "prisma": "^6.19.0",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
