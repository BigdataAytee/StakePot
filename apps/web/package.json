{
  "name": "@stakeam/web",
  "version": "0.1.0",
  "private": true,
  "description": "StakeAm user app and /admin routes.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "../../scripts/dev/start-web.sh",
    "test": "vitest run --passWithNoTests",
    "test:props": "vitest run --passWithNoTests props",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src e2e --max-warnings=0",
    "migrate": "node -e \"console.log('no database in apps/web \u2014 run pnpm --filter @stakeam/api migrate')\""
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@hookform/resolvers": "^5.9.1",
    "@sentry/nextjs": "^10.24.0",
    "@serwist/next": "^9.5.12",
    "@stakeam/engine": "workspace:*",
    "@stakeam/tokens": "workspace:*",
    "@vercel/og": "^1.0.1",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.24",
    "lightweight-charts": "^5.0.9",
    "lucide-react": "^0.549.0",
    "next": "^15.5.6",
    "next-intl": "^4.13.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.85.0",
    "serwist": "^9.5.12",
    "socket.io-client": "^4.8.1",
    "zod": "^4.1.13",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
