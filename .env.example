# StakeAm — environment template.
#
# Copy to .env and fill in. NEVER commit a real value: .env is gitignored and
# must stay that way. Every variable the Phase 0 dependency manifest implies is
# listed here, including the ones whose integrations are still stubs.

# ---------------------------------------------------------------- runtime
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
WEB_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------- data
# Matches the docker-compose service. In production, connect as the
# `stakeam_app` role so the ledger's REVOKE UPDATE/DELETE actually binds.
DATABASE_URL=postgresql://stakeam:stakeam@localhost:5432/stakeam
REDIS_URL=redis://localhost:6379

# Integration tests run against this database and wipe it between cases. Point
# it somewhere disposable — never at a database with anything you want to keep.
TEST_DATABASE_URL=postgresql://stakeam:stakeam@localhost:5432/stakeam_test

# ---------------------------------------------------------------- auth
# 32+ characters. Generate with: openssl rand -base64 48
JWT_SECRET=

# Key for secrets stored encrypted at rest — TOTP seeds today (§2.11).
# At least 32 characters, and NOT the same value as JWT_SECRET: rotating one
# should never force rotating the other. The database never sees it, which is
# the whole point — a dump alone cannot open what it protects.
SECRETS_KEY=

# Superseded values, comma-separated, newest first (§2.11 rotation).
#
# A rotation is three steps and no downtime: put the new key in SECRETS_KEY and
# move the old one here, let the re-seal sweep run, then delete the retired
# entry. Values here are accepted for reading and never used for writing, so
# anything still sealed under a key you delete becomes unreadable — check the
# system room's key panel before emptying it.
SECRETS_KEY_PREVIOUS=
JWT_SECRET_PREVIOUS=

# Signs proof-of-reserves exports (§2.10). At least 32 characters. Without it
# the export still produces every figure and marks itself unsigned, which is
# more useful than refusing to show a finance operator their own position.
# The verification key is what an external auditor is given, out of band.
RESERVES_SIGNING_KEY=
RESERVES_SIGNING_KEY_PREVIOUS=

JWT_EXPIRES_IN=15m

# ---------------------------------------------------------------- AI (§2.9, §2.14a)
# Question engine and wizard co-pilot. Installed at step 6.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- observability
SENTRY_DSN=
# The web app's own public origin. robots.txt, the sitemap and every Open Graph
# tag need an absolute URL and cannot derive one from a request.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------- SMS (Termii)
# Thin REST client in apps/api/src/integrations/termii.ts — no SDK.
TERMII_KEY=
TERMII_SENDER_ID=StakeAm
TERMII_BASE_URL=https://api.ng.termii.com

# ---------------------------------------------------------------- web push (step 9)
# Generate with: pnpm dlx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Transactional email (§2.12). Without SMTP_URL the notifier logs instead of
# sending, so development never silently drops a message it thinks it sent.
#
# One of SMTP_URL or TERMII_KEY has to be real for anybody to reach Tier 1: the
# verification code goes to email or SMS and nowhere else, and the API refuses
# to claim it sent one that no channel took. For local work and for the browser
# journeys there is a sink that accepts and discards:
#
#   node scripts/dev/smtp-sink.mjs &
#   SMTP_URL=smtp://127.0.0.1:1025
SMTP_URL=
EMAIL_FROM=StakeAm <no-reply@stakeam.ng>

VAPID_SUBJECT=mailto:support@stakeam.ng

# ---------------------------------------------------------------- web app
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---------------------------------------------------------------- licensed phase
# Not wired up. apps/api/src/integrations/*.stub.ts throws NotImplementedError
# until the licences land; these are here so the shape is agreed in advance.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
SMILEID_PARTNER_ID=
SMILEID_API_KEY=
